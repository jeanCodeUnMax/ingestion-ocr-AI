{
  "ingestion": {
    "version": "1.0.0",
    "sources": {
      "workspace_root": "../..",
      "exclude": [
        "**/.git/**",
        "**/node_modules/**",
        "**/dist/**",
        "**/.vscode/**",
        "**/.trae/**",
        "**/.windsurf/**",
        "**/.venv/**",
        "**/venv/**"
      ],
      "max_file_size_mb": 5
    },
    "metadata": {
      "workspace": "${workspaceBasename}"
    }
  }
}