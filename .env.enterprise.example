DEPLOYMENT_MODE=enterprise
FEATURE_AUTH=true
FEATURE_MULTI_TENANT=true
FEATURE_BILLING=false
AUTH_TOKEN_SECRET=replace-with-a-long-random-secret
AUTH_ALLOW_REGISTRATION=false
OCR_PROVIDER=llama-cpp
EMBEDDING_PROVIDER=llama-cpp
ANALYSIS_PROVIDER=llama-cpp
TRANSLATION_PROVIDER=llama-cpp
AUDIO_TRANSCRIPTION_PROVIDER=whisper-cpp

FEATURE_PROJECTS=true
FEATURE_URL_INGESTION=true
FEATURE_CHAT_RAG=true
FEATURE_KNOWLEDGE_ENRICHMENT=true
FEATURE_SVG=true
DEFAULT_RECIPE_PROFILE=standard
