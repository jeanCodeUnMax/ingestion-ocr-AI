# ------------------------------------------------------------------------------
.env
.env.local
.env.*.local
*.pem
*.key
*.cert
*.pfx

# ------------------------------------------------------------------------------
# 2. DÉPENDANCES ET BUILDS NODE.JS / TS
# ------------------------------------------------------------------------------
node_modules/
dist/
build/
out/
.next/
.turbo/
.cache/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ------------------------------------------------------------------------------
# 3. DÉPENDANCES ET CACHES PYTHON
# ------------------------------------------------------------------------------
.venv/
venv/
env/
ENV/
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/
.eggs/

# ------------------------------------------------------------------------------
# 4. BASES DE DONNÉES LOCALES ET DONNÉES RUNTIME
# ------------------------------------------------------------------------------
*.sqlite
*.sqlite3
*.db
*.sqlite-wal
*.sqlite-shm

# Données d'exécution et projets (conserver .gitkeep)
runtime/*
!runtime/**/.gitkeep
workspaces/*
!workspaces/**/.gitkeep

