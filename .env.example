# =========================================================
# OCR AI System v0.6 — profil et feature flags
# =========================================================
HOST=127.0.0.1
PORT=8000
DEPLOYMENT_MODE=personal
WORKSPACE_ROOT=./workspaces
PROJECTS_ROOT=./projects
RUNTIME_ROOT=./runtime
VECTOR_DB_PATH=./runtime/vector/vectors.sqlite
MAX_UPLOAD_BYTES=536870912
MAX_URL_BYTES=67108864
URL_FETCH_TIMEOUT_MS=30000
DEFAULT_RECIPE_PROFILE=standard

# Formats et modules
FEATURE_WORD=true
FEATURE_EXCEL=true
FEATURE_CSV=true
FEATURE_JSON=true
FEATURE_MARKDOWN=true
FEATURE_TEXT=true
FEATURE_IMAGE=true
FEATURE_SVG=true
FEATURE_AUDIO=false
FEATURE_TRANSLATION=true
FEATURE_COMPARISON=true
FEATURE_ADVANCED_WORKSPACE=true
FEATURE_PROJECTS=true
FEATURE_URL_INGESTION=true
FEATURE_CHAT_RAG=true
FEATURE_KNOWLEDGE_ENRICHMENT=true

# Modules préparés, désactivés par défaut
FEATURE_AUTH=false
FEATURE_BILLING=false
FEATURE_MULTI_TENANT=false

# Auth locale v0.6 — uniquement si FEATURE_AUTH=true
AUTH_TOKEN_SECRET=change-me-before-enabling-auth
AUTH_TOKEN_TTL_SECONDS=86400
AUTH_ALLOW_REGISTRATION=false

# Audio : none | mistral | whisper-cpp
AUDIO_TRANSCRIPTION_PROVIDER=none
WHISPER_CPP_BASE_URL=http://127.0.0.1:8081
WHISPER_CPP_TIMEOUT_MS=600000
WHISPER_CPP_LANGUAGE=auto

# Python workers
PYTHON_BIN=python
PDF_RENDER_DPI=160
PDF_FALLBACK_DPI=110
MIN_NATIVE_TEXT_CHARS=40
VISUAL_ANALYSIS_MODE=auto

# OCR : none | llama-cpp | mistral
OCR_PROVIDER=none
MAX_PROCESSING_ATTEMPTS=3

# File de jobs persistante
JOB_MAX_ATTEMPTS=3
JOB_POLL_INTERVAL_MS=750

# Embeddings : hash | llama-cpp | mistral
EMBEDDING_PROVIDER=hash
EMBEDDING_BATCH_SIZE=16
CHUNK_MAX_CHARS=1800
CHUNK_OVERLAP_CHARS=240
HASH_EMBEDDING_DIMENSIONS=384

# Analyse : rules | llama-cpp | mistral
ANALYSIS_PROVIDER=rules
ANALYSIS_MAX_CHARS_PER_SEGMENT=12000
ANALYSIS_MAX_SOURCE_CHUNKS_PER_SEGMENT=8
ANALYSIS_TIMEOUT_MS=300000

# Traduction : none | llama-cpp | mistral
TRANSLATION_PROVIDER=none
TRANSLATION_MAX_CHARS_PER_SEGMENT=9000
TRANSLATION_TIMEOUT_MS=300000

# llama.cpp / llama-server
LLAMA_CPP_BASE_URL=http://127.0.0.1:8080/v1
LLAMA_CPP_MODEL=qwen-ocr
LLAMA_CPP_EMBEDDING_MODEL=embedding-model
LLAMA_CPP_ANALYSIS_MODEL=analysis-model
LLAMA_CPP_CONTEXT_TOKENS=32768
LLAMA_CPP_MAX_PAGES=5
LLAMA_CPP_RESERVED_OUTPUT_TOKENS=10000
LLAMA_CPP_SAFETY_RATIO=0.78
LLAMA_CPP_TIMEOUT_MS=300000

# Mistral OCR + embeddings + analyse + traduction + audio
MISTRAL_API_KEY=
MISTRAL_BASE_URL=https://api.mistral.ai/v1
MISTRAL_OCR_MODEL=mistral-ocr-latest
MISTRAL_EMBEDDING_MODEL=mistral-embed
MISTRAL_ANALYSIS_MODEL=mistral-small-latest
MISTRAL_AUDIO_MODEL=voxtral-mini-latest
MISTRAL_MAX_PAGES=10
MISTRAL_TIMEOUT_MS=300000
