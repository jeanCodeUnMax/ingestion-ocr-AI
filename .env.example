# Hephaistos-Kit Configuration
# Copy this file to .env and customize for your environment

# =============================================================================
# MEMORY STORAGE CONFIGURATION
# =============================================================================

# Global storage root (optional)
# If set, memory databases will be stored in CASCADE_DB_ROOT/current_workspace/
# If not set, local storage (./memory-database/) will be used

# Uncomment and set your custom path:

# CASCADE_DB_ROOT=C:\DATA-WEBMAN\memory


# Examples:
# Windows: CASCADE_DB_ROOT=D:\cascade-db
# Linux: CASCADE_DB_ROOT=/var/lib/cascade-db
# macOS: CASCADE_DB_ROOT=/Users/votre_user/cascade-db

# =============================================================================
# ADDITIONAL CONFIGURATION (future use)
# =============================================================================

# MCP servers port (default: auto-assigned)
 MCP_PORT=3000

Log level (debug, info, warn, error)
# LOG_LEVEL=info


# ===========================================
# RAG System Environment Variables
# ===========================================

# === WORKSPACE ===
RAG_WORKSPACE_ROOT=

# ===========================================
# MCP SERVERS PATHS (portability)
# ===========================================

# Chemins des serveurs MCP (laisser vide pour utiliser workspace.config.json ou fallback relatif)
# ZVEC_MCP_PATH=C:/mcp/Zvec/build/index.js
# MEMORY_MCP_PATH=C:/mcp/servers/src/memory/dist/index.js

# Répertoires de données MCP
# ZVEC_DATA_DIR=./memory-database/agentmemory/vector/zvec-data
# MEMORY_DB_PATH=./memory-database/agentmemory/graph/memory_mcp.db

# Ports du bridge REST (serveur HTTP local)
# Ces ports définissent où le pont rag_rest_bridge.py écoute
# Les URLs client (RAG_ZVEC_URL, RAG_MEMORY_URL) doivent correspondre
ZVEC_BRIDGE_PORT=8001
MEMORY_BRIDGE_PORT=8002



# === ZVEC (client - doit correspondre à ZVEC_BRIDGE_PORT) ===
RAG_ZVEC_ENABLED=true
RAG_ZVEC_URL=http://127.0.0.1:8001
RAG_ZVEC_PROVIDER=local
RAG_ZVEC_MODEL=Xenova/all-MiniLM-L6-v2
RAG_ZVEC_DIMENSIONS=384

# === MEMORY MCP (client - doit correspondre à MEMORY_BRIDGE_PORT) ===
RAG_MEMORY_URL=http://localhost:8002
RAG_MEMORY_ENTITY_TYPE=chunk



# === COLLECTIONS ZVEC ===
RAG_ZVEC_COLLECTION_CONCEPTS=concepts_index
RAG_ZVEC_COLLECTION_ENTITIES=entities_index
RAG_ZVEC_COLLECTION_ACTIONS=actions_index
RAG_ZVEC_COLLECTION_RELATIONS=relations_index
RAG_ZVEC_COLLECTION_CONTEXT=context_index

# === CHUNKING ===
RAG_CHUNK_DEFAULT_SIZE=300
RAG_CHUNK_OVERLAP_PERCENT=10
RAG_CHUNK_MIN_SIZE=50
RAG_CHUNK_MAX_SIZE=1000
RAG_CHUNK_TYPE_ATOMIC_MIN=50
RAG_CHUNK_TYPE_ATOMIC_MAX=100
RAG_CHUNK_TYPE_MODULAR_MIN=200
RAG_CHUNK_TYPE_MODULAR_MAX=500
RAG_CHUNK_TYPE_CONTEXTUAL_MIN=500
RAG_CHUNK_TYPE_CONTEXTUAL_MAX=1000
RAG_CHUNK_TYPE_STRUCTURAL_MIN=100
RAG_CHUNK_TYPE_STRUCTURAL_MAX=2000

# === TAGGING ===
RAG_TAG_AUTO_DETECT=true
RAG_TAG_MIN_CONFIDENCE=0.7
RAG_TAG_MAX_PER_CHUNK=10

# === ROUTING ===
RAG_ROUTING_STRATEGY=dual
RAG_ROUTING_FALLBACK=both
RAG_ROUTING_MIN_SCORE=0.5

# === FUSION ===
RAG_FUSION_WEIGHT_QDRANT=0.4
RAG_FUSION_WEIGHT_ZVEC=0.4
RAG_FUSION_WEIGHT_MEMORY=0.2
RAG_FUSION_MIN_RESULTS=5
RAG_FUSION_MAX_RESULTS=20

# === LOGGING ===
RAG_LOG_LEVEL=INFO
